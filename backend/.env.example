PORT=4000
HOST=0.0.0.0
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
JWT_SECRET=
JWT_EXPIRES_IN=8h
PAYMENT_PROVIDER=recurrente
# mock: simulador local sin API. recurrente: checkout alojado en Recurrente.
PAYMENT_MODE=sandbox
# Sandbox: llave sk_test_ del ambiente nombrado. Producción: sk_live_.
RECURRENTE_SECRET_KEY=
# Firma del endpoint de webhook del mismo ambiente (whsec_...).
RECURRENTE_WEBHOOK_SECRET=
NODE_ENV=development
BACKEND_BASE_URL=http://localhost:4000
FRONTEND_BASE_URL=http://localhost:5173/Sistemas-de-Control-de-Pago
# Cuenta de Gmail que envía los recordatorios de pago. Va en .env.local (ignorado por git).
# Con verificación en 2 pasos, usa una "contraseña de aplicación", no la contraseña normal.
CORREO_RECORDATORIOS_USER=
CORREO_RECORDATORIOS_PASS=
# Minutos mínimos entre dos recordatorios del mismo ticket.
RECORDATORIO_INTERVALO_MIN=60
# Flujo "pagar primero": la entrada exige un pago vigente del día. false = solo se bloquea la salida.
# Las entradas se registran sin pago previo; el cobro exige una entrada activa.
# true solo si el backend corre detrás de un proxy propio: habilita X-Forwarded-For para el límite de peticiones por IP.
TRUST_PROXY=false
