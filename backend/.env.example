PORT=4000
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
JWT_SECRET=
JWT_EXPIRES_IN=8h
PAYMENT_PROVIDER=recurrente
# mock: simulador local sin API. recurrente: checkout alojado en Recurrente.
PAYMENT_MODE=sandbox
# Sandbox: llave sk_test_ del ambiente nombrado. Producción: sk_live_.
RECURRENTE_SECRET_KEY=
# Firma del endpoint de webhook del mismo ambiente (whsec_...).
RECURRENTE_WEBHOOK_SECRET=
NODE_ENV=development
BACKEND_BASE_URL=http://localhost:4000
FRONTEND_BASE_URL=http://localhost:5173/Sistemas-de-Control-de-Pago
